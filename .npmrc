# Pin auto-install-peers to match the committed pnpm-lock.yaml `settings` block
# (autoInstallPeers: false). Without this, a fresh `pnpm install --frozen-lockfile`
# on a machine that doesn't set it globally (CI runners, the Docker build) fails
# with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH. Keeping it in-repo makes installs
# reproducible everywhere.
auto-install-peers=false
