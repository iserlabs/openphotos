# Postgres connection string for @luminance/db (Neon in prod, PGlite in tests).
DATABASE_URL=postgres://user:password@localhost:5432/luminance

# Canonical public origin this app is served from (used to build absolute URLs, OAuth redirects, etc.).
PUBLIC_URL=http://localhost:3000

# Random secret used to sign/encrypt session cookies (iron-session). Generate with `openssl rand -hex 32`.
SESSION_SECRET=changeme-generate-a-random-32-byte-hex-string

# Comma-separated list of DIDs granted admin access (no spaces), e.g. did:plc:aaa,did:plc:bbb.
ADMIN_DIDS=

# Sentry DSN for error reporting. Optional — leave blank to disable Sentry.
SENTRY_DSN=

# ATProto OAuth signing key (JWK JSON), used from Task 13 (OAuth). Generate per that task's instructions.
OAUTH_JWK_1=
