# Postgres connection string for @openphotos/db (Neon in prod, PGlite in tests).
DATABASE_URL=postgres://user:password@localhost:5432/openphotos

# Canonical public origin this app is served from (used to build absolute URLs, OAuth redirects, etc.).
PUBLIC_URL=http://localhost:3000

# Random secret used to sign/encrypt session cookies (iron-session). Generate with `openssl rand -hex 32`.
SESSION_SECRET=changeme-generate-a-random-32-byte-hex-string

# Comma-separated list of DIDs granted admin access (no spaces), e.g. did:plc:aaa,did:plc:bbb.
ADMIN_DIDS=

# Sentry DSN for error reporting. Optional — leave blank to disable Sentry.
SENTRY_DSN=

# ATProto OAuth signing key (ES256 private JWK as single-line JSON), used from
# Task 13 (OAuth). MUST include a "kid" (required for private_key_jwt client auth
# and the served JWKS). Generate a dev key with:
#   node --input-type=module -e 'import {JoseKey} from "@atproto/jwk-jose"; import {randomUUID} from "node:crypto"; const k=await JoseKey.generate(["ES256"], `openphotos-${randomUUID()}`); console.log(JSON.stringify({...k.privateJwk, alg:"ES256"}))'
# Put the output in .env.local (gitignored). In prod, store it in a secret manager — NEVER commit a real private key.
OAUTH_JWK_1=
